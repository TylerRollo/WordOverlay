<Window x:Class="WordOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MinWidth="220"
        MinHeight="100"
        SizeToContent="Manual">

    <Window.Resources>
        <Style x:Key="InvisibleThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main content panel -->
        <Border Background="#80000000"
                CornerRadius="8"
                Padding="16"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="WordText"
                           Grid.Row="0"
                           Text="Word"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="DefinitionText"
                           Grid.Row="1"
                           Text="Definition"
                           FontSize="14"
                           Foreground="White"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Resize thumbs: fully invisible via empty template, placed at edges/corner -->
        <Thumb x:Name="ResizeThumbBottomRight"
               Style="{StaticResource InvisibleThumbStyle}"
               Width="14" Height="14"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               DragDelta="ResizeThumbBottomRight_DragDelta"/>

        <Thumb x:Name="ResizeThumbRight"
               Style="{StaticResource InvisibleThumbStyle}"
               Width="6"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Margin="0,0,0,14"
               Cursor="SizeWE"
               DragDelta="ResizeThumbRight_DragDelta"/>

        <Thumb x:Name="ResizeThumbBottom"
               Style="{StaticResource InvisibleThumbStyle}"
               Height="6"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Margin="0,0,14,0"
               Cursor="SizeNS"
               DragDelta="ResizeThumbBottom_DragDelta"/>
    </Grid>
</Window>
